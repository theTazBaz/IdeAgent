# IdeAgent — environment variable template
# Copy this file to .env and fill in your values
# .env is in .gitignore — never commit real credentials

# ------------------------------------------------------------------
# DATABASE  (required for all pipeline steps)
# Supabase Dashboard → Project Settings → Database → Connection string → URI
# ------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ------------------------------------------------------------------
# TMDB  (movie + character metadata)
# Free API key (no credit card): https://www.themoviedb.org/settings/api
# ------------------------------------------------------------------
TMDB_API_KEY=

# ------------------------------------------------------------------
# SPOTIFY  (song audio features + metadata)
# Create a free dev app: https://developer.spotify.com/dashboard
# ------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ------------------------------------------------------------------
# GEMINI  (LLM synthesis step — Gemini Flash 2.0)
# Free API key (no credit card): https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------
GEMINI_API_KEY=

